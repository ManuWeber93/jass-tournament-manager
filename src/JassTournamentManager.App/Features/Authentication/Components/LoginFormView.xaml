<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="JassTournamentManager.App.Features.Authentication.Components.LoginFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:JassTournamentManager.App.Resources.Localization"
    xmlns:components="clr-namespace:JassTournamentManager.App.Features.Authentication.Components"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:validation="clr-namespace:InputKit.Shared.Validations;assembly=InputKit.Maui"
    xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui">

    <VerticalStackLayout
    Spacing="12">
        <Label
        Text="{x:Static resources:AppResources.Login_Title}"
        FontSize="22"
        FontAttributes="Bold" />

        <components:DeferredValidationTextField Title="{x:Static resources:AppResources.Login_Email}" Text="{Binding Email}" Keyboard="Email" IsEnabled="{Binding IsNotBusy}">
            <validation:RequiredValidation Message="{x:Static resources:AppResources.Register_ErrorMessage_EmailRequired}" />
            <validation:RegexValidation Pattern="{x:Static input:AdvancedEntry.REGEX_EMAIL}" />
        </components:DeferredValidationTextField>

        <components:DeferredValidationTextField Title="{x:Static resources:AppResources.Login_Password}" Text="{Binding Password}" IsPassword="True" IsEnabled="{Binding IsNotBusy}">
            <components:DeferredValidationTextField.Attachments>
                <material:TextFieldPasswordShowHideAttachment SemanticProperties.Description="{x:Static resources:AppResources.Auth_TogglePasswordVisibility}" />
            </components:DeferredValidationTextField.Attachments>
            <validation:RequiredValidation Message="{x:Static resources:AppResources.Register_ErrorMessage_PasswordRequired}" />
        </components:DeferredValidationTextField>

        <Label
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            TextColor="{StaticResource AppDanger}" />

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center" />

        <Button
            Text="{x:Static resources:AppResources.Login_Login}"
            IsEnabled="{Binding IsNotBusy}"
            Command="{Binding LoginCommand}" />
    </VerticalStackLayout>

</ContentView>